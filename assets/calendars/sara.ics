---
layout: none
---
BEGIN:VCALENDAR
VERSION:2.0
PRODID:http://sarajuhosova.com/av40-schedule/sara
X-WR-CALNAME:pl
CALSCALE:GREGORIAN
BEGIN:VTIMEZONE
TZID:Europe/Amsterdam
TZURL:http://tzurl.org/zoneinfo-outlook/Europe/Amsterdam
X-LIC-LOCATION:Europe/Amsterdam
BEGIN:DAYLIGHT
TZOFFSETFROM:+0100
TZOFFSETTO:+0200
TZNAME:CEST
DTSTART:19700329T020000
RRULE:FREQ=YEARLY;BYMONTH=3;BYDAY=-1SU
END:DAYLIGHT
BEGIN:STANDARD
TZOFFSETFROM:+0200
TZOFFSETTO:+0100
TZNAME:CET
DTSTART:19701025T030000
RRULE:FREQ=YEARLY;BYMONTH=10;BYDAY=-1SU
END:STANDARD
END:VTIMEZONE

{% assign trainings = site.data.schedule.2026.q3 %}
{% for day in trainings %}
        {% if day.cancelled %}
            {% continue %}
        {% endif %}

        {% for training in day.trainings %}
            {% if training.trainer contains "Sára" %}
                BEGIN:VEVENT
                LOCATION:AV'40
                SUMMARY:Training ({{ training.group }})
                CLASS:PUBLIC
                DTSTART;TZID=Europe/Amsterdam:{{ training.date | date: "%Y%m%d" }}T191500
                DTEND;TZID=Europe/Amsterdam:{{ training.date | date: "%Y%m%d" }}T204500
                END:VEVENT
            {% endif %}
        {% endfor %}
{% endfor %}
